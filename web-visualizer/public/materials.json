{
  "default": "block",
  "floor": "liquid",
  "materials": [
    {
      "id": "block",
      "label": "Block",
      "blurb": "Sinks under what is below",
      "color": "#c4624e",
      "surface": "solid",
      "rules": [
        {
          "name": "fall",
          "diagram": [
            "@ => _",
            "_    @"
          ]
        },
        {
          "name": "lone-dissolve",
          "when": { "resting": true, "onFloor": true, "sameAbove": false },
          "do": { "age": 3.5, "visual": "shrink", "then": "clear" }
        },
        {
          "name": "crush-support",
          "when": { "sameAbove": true, "sameBelow": false },
          "do": { "age": 3.5, "then": "clear" }
        }
      ]
    }
    ,
    {
      "id": "sand",
      "label": "Sand",
      "blurb": "Piles into gaps and spreads",
      "color": "#e0a84a",
      "surface": "solid",
      "rules": [
        {
          "name": "fall",
          "diagram": [
            "@ => _",
            "_    @"
          ]
        },
        {
          "name": "slide",
          "any": "xz.rotations",
          "diagram": [
            "@. => _.",
            "x_    x@"
          ]
        }
      ]
    }
    ,
    {
      "id": "diffuse",
      "label": "Diffuse",
      "blurb": "Spreads and floats away",
      "color": "#f4d59a",
      "surface": "solid",
      "rules": [
        {
          "name": "fall",
          "diagram": [
            "@ => _",
            "_    @"
          ]
        },
        {
          "name": "slide",
          "any": "xz.rotations",
          "diagram": [
            "@. => _.",
            "x_    x@"
          ]
        },
        {
          "name": "blow",
          "when": { "resting": true, "above": false },
          "do": { "age": 4.5, "hold": 2, "lifeScale": 0.5, "visual": "rise", "then": "clear" }
        },
        {
          "name": "spread",
          "do": { "convert": { "any": true, "limit": "collection" } }
        }
      ]
    },
    {
      "id": "erode",
      "label": "Erode",
      "blurb": "Cuts through a pile",
      "color": "#7a9e6a",
      "surface": "solid",
      "sonify": false,
      "rules": [
        {
          "name": "fall",
          "diagram": [
            "@ => _",
            "_    @"
          ]
        },
        {
          "name": "slide",
          "any": "xz.rotations",
          "diagram": [
            "@. => _.",
            "x_    x@"
          ]
        },
        {
          "name": "creep",
          "maybe": 0.25,
          "any": "xz.rotations",
          "supportUnderDest": true,
          "diagram": ["@_ => _@"]
        },
        {
          "name": "lone-dissolve",
          "when": { "resting": true, "onFloor": true, "sameAbove": false, "blockAbove": false },
          "do": { "age": 6, "visual": "shrink", "then": "clear" }
        },
        {
          "name": "crush-support",
          "when": { "resting": true, "onFloor": true, "sameAbove": true },
          "do": { "age": 6, "then": "clear" }
        },
        {
          "name": "vacuum",
          "do": { "vacuum": { "skipSurface": "liquid" }, "then": "clear" }
        }
      ]
    }
